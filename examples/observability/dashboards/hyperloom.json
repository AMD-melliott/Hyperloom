{
  "title": "Hyperloom session",
  "uid": "hyperloom-session",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": {
    "from": "now-12h",
    "to": "now"
  },
  "tags": [
    "hyperloom"
  ],
  "timezone": "browser",
  "editable": true,
  "graphTooltip": 1,
  "description": "One Hyperloom session: summary, timeline and, in the collapsed row, live runtime status. Pick any session Prometheus still holds; set the time range to cover it.",
  "links": [
    {
      "title": "Run history",
      "type": "link",
      "url": "/d/hyperloom-overview/hyperloom-history",
      "icon": "dashboard"
    }
  ],
  "annotations": {
    "list": [
      {
        "name": "Kept",
        "enable": true,
        "iconColor": "green",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "target": {
          "refId": "Anno",
          "expr": "max by (ordinal, lever, outcome) (hyperloom_optimization_info{session_id=\"$session\",outcome=\"KEEP\"}) unless max by (ordinal, lever, outcome) (hyperloom_optimization_info{session_id=\"$session\",outcome=\"KEEP\"} offset 60s)",
          "step": "60s",
          "instant": false,
          "range": true,
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "titleFormat": "KEEP",
          "textFormat": "{{lever}}",
          "tagKeys": "outcome"
        }
      },
      {
        "name": "Reverted",
        "enable": true,
        "iconColor": "red",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "target": {
          "refId": "Anno",
          "expr": "max by (ordinal, lever, outcome) (hyperloom_optimization_info{session_id=\"$session\",outcome=\"REVERT\"}) unless max by (ordinal, lever, outcome) (hyperloom_optimization_info{session_id=\"$session\",outcome=\"REVERT\"} offset 60s)",
          "step": "60s",
          "instant": false,
          "range": true,
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "titleFormat": "REVERT",
          "textFormat": "{{lever}}",
          "tagKeys": "outcome"
        }
      }
    ]
  },
  "templating": {
    "list": [
      {
        "name": "datasource",
        "type": "datasource",
        "query": "prometheus",
        "label": "Datasource"
      },
      {
        "name": "session",
        "label": "Session",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "query": {
          "query": "sort_desc(label_join(label_replace(label_replace(max by (session_id, model) (last_over_time(hyperloom_session_start_timestamp_seconds[60d])), \"name\", \"$1\", \"model\", \".*/(.*)\"), \"day\", \"$1\", \"session_id\", \".*_(\\\\d{8})T.*\"), \"label\", \" \", \"name\", \"day\"))",
          "refId": "session"
        },
        "definition": "sort_desc(label_join(label_replace(label_replace(max by (session_id, model) (last_over_time(hyperloom_session_start_timestamp_seconds[60d])), \"name\", \"$1\", \"model\", \".*/(.*)\"), \"day\", \"$1\", \"session_id\", \".*_(\\\\d{8})T.*\"), \"label\", \" \", \"name\", \"day\"))",
        "regex": "/label=\"(?<text>[^\"]+)\".*session_id=\"(?<value>[^\"]+)\"/",
        "refresh": 1,
        "sort": 0
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Status",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "expr": "hyperloom_liveness{session_id=\"$session\"} == 1",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "legendFormat": "{{state}}",
          "instant": true,
          "range": false
        },
        {
          "refId": "B",
          "expr": "topk(1, max by (reason) (max_over_time(timestamp(hyperloom_stop_info{session_id=\"$session\"})[$__range:1m])))",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "legendFormat": "{{reason}}",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "fixed",
            "fixedColor": "blue"
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "live": {
                  "text": "running",
                  "color": "green",
                  "index": 0
                },
                "stale": {
                  "text": "stale",
                  "color": "orange",
                  "index": 1
                },
                "dead": {
                  "text": "ended",
                  "color": "text",
                  "index": 2
                },
                "unknown": {
                  "text": "unknown",
                  "color": "text",
                  "index": 3
                },
                "target_reached": {
                  "text": "target reached",
                  "color": "green",
                  "index": 4
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "description": "Live state while the optimizer runs; the stop reason once it has ended (kept after the exporter exits).",
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "name",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Phase",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 4,
        "y": 0,
        "w": 3,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "expr": "topk(1, max by (phase) (max_over_time(timestamp(hyperloom_phase_current{session_id=\"$session\"} == 1)[$__range:1m])))",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "legendFormat": "{{phase}}",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "fixed",
            "fixedColor": "blue"
          }
        },
        "overrides": []
      },
      "description": "Current phase, or the last one the session reached.",
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "name",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Validated gain",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 7,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "expr": "last_over_time(hyperloom_gain_percent{session_id=\"$session\",kind=\"validated\"}[$__range])",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "legendFormat": "validated",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 1,
          "color": {
            "mode": "fixed",
            "fixedColor": "blue"
          }
        },
        "overrides": []
      },
      "description": "Gain over baseline re-measured on a fresh server; the figure to trust.",
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Target gap",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 11,
        "y": 0,
        "w": 3,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "expr": "last_over_time(hyperloom_target_gap_percent{session_id=\"$session\"}[$__range])",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "legendFormat": "gap",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 0.001
              }
            ]
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "reached",
                  "color": "green",
                  "index": 0
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "description": "Remaining gain needed to reach the target. 0 means the target is reached.",
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      }
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Baseline \u2192 best",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 14,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "expr": "last_over_time(hyperloom_throughput_baseline{session_id=\"$session\"}[$__range])",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "legendFormat": "baseline",
          "instant": true,
          "range": false
        },
        {
          "refId": "B",
          "expr": "last_over_time(hyperloom_throughput_best{session_id=\"$session\"}[$__range])",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "legendFormat": "best",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "decimals": 1,
          "color": {
            "mode": "fixed",
            "fixedColor": "blue"
          }
        },
        "overrides": []
      },
      "description": "Throughput in the session's graded unit.",
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value_and_name",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      }
    },
    {
      "id": 6,
      "type": "stat",
      "title": "Accuracy",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 18,
        "y": 0,
        "w": 3,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max by (stage) (last_over_time(hyperloom_accuracy{session_id=\"$session\"}[$__range]))",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "legendFormat": "{{stage}}",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "decimals": 4,
          "color": {
            "mode": "fixed",
            "fixedColor": "blue"
          }
        },
        "overrides": []
      },
      "description": "Accuracy-eval score of the baseline and of the best adopted stack. Empty for runs recorded before this series existed.",
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value_and_name",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      }
    },
    {
      "id": 7,
      "type": "stat",
      "title": "Session clock",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 21,
        "y": 0,
        "w": 3,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "expr": "last_over_time(hyperloom_session_elapsed_seconds{session_id=\"$session\"}[$__range])",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "legendFormat": "elapsed",
          "instant": true,
          "range": false
        },
        {
          "refId": "B",
          "expr": "last_over_time(hyperloom_session_remaining_seconds{session_id=\"$session\"}[$__range])",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "legendFormat": "remaining",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "color": {
            "mode": "fixed",
            "fixedColor": "blue"
          }
        },
        "overrides": []
      },
      "description": "Producer session clock.",
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value_and_name",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      }
    },
    {
      "id": 8,
      "type": "row",
      "title": "Timeline",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Throughput (graded unit)",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 5,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "hyperloom_throughput_baseline{session_id=\"$session\"}",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "legendFormat": "baseline"
        },
        {
          "refId": "B",
          "expr": "hyperloom_throughput_best{session_id=\"$session\"}",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "legendFormat": "best"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "stepAfter",
            "lineWidth": 2,
            "fillOpacity": 8,
            "showPoints": "never",
            "spanNulls": true,
            "axisPlacement": "auto"
          },
          "decimals": 1
        },
        "overrides": []
      },
      "description": "Baseline and best throughput. Markers show kept and reverted attempts.",
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      }
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Gain over baseline",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 12,
        "y": 5,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "hyperloom_gain_percent{session_id=\"$session\"}",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "legendFormat": "{{kind}}"
        },
        {
          "refId": "B",
          "expr": "hyperloom_target_gap_percent{session_id=\"$session\"}",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "legendFormat": "target gap"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "stepAfter",
            "lineWidth": 2,
            "fillOpacity": 8,
            "showPoints": "never",
            "spanNulls": true,
            "axisPlacement": "auto"
          },
          "unit": "percent",
          "decimals": 1
        },
        "overrides": []
      },
      "description": "Raw is the provisional per-round sum; validated is re-measured on a fresh server.",
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      }
    },
    {
      "id": 11,
      "type": "state-timeline",
      "title": "Phase timeline",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 13,
        "w": 24,
        "h": 5
      },
      "targets": [
        {
          "refId": "A",
          "expr": "hyperloom_phase_current{session_id=\"$session\"}",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "legendFormat": "{{phase}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "transparent",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          },
          "custom": {
            "fillOpacity": 70,
            "lineWidth": 0
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "idle",
                  "color": "transparent",
                  "index": 0
                },
                "1": {
                  "text": "active",
                  "color": "green",
                  "index": 1
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "description": "Which phase was active over time.",
      "options": {
        "alignValue": "left",
        "mergeValues": true,
        "rowHeight": 0.9,
        "showValue": "never",
        "legend": {
          "showLegend": false
        },
        "tooltip": {
          "mode": "single"
        }
      }
    },
    {
      "id": 12,
      "type": "bargauge",
      "title": "Time per phase",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 18,
        "w": 10,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "last_over_time(hyperloom_phase_elapsed_seconds{session_id=\"$session\"}[$__range])",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "legendFormat": "{{phase}}",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0,
          "color": {
            "mode": "fixed",
            "fixedColor": "blue"
          }
        },
        "overrides": []
      },
      "description": "Cumulative time charged to each phase.",
      "options": {
        "displayMode": "gradient",
        "orientation": "horizontal",
        "showUnfilled": true,
        "valueMode": "color",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      }
    },
    {
      "id": 13,
      "type": "table",
      "title": "Attempts (KEEP and REVERT)",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 10,
        "y": 18,
        "w": 14,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max by (ordinal, phase, kind, lever, outcome) (last_over_time(hyperloom_optimization_info{session_id=\"$session\"}[$__range]))",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "format": "table",
          "instant": true,
          "range": false
        },
        {
          "refId": "B",
          "expr": "max by (ordinal) (last_over_time(hyperloom_optimization_throughput{session_id=\"$session\"}[$__range]))",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "format": "table",
          "instant": true,
          "range": false
        },
        {
          "refId": "C",
          "expr": "max by (ordinal) (last_over_time(hyperloom_optimization_gain_percent{session_id=\"$session\"}[$__range]))",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "format": "table",
          "instant": true,
          "range": false
        },
        {
          "refId": "D",
          "expr": "max by (ordinal) (last_over_time(hyperloom_optimization_accuracy{session_id=\"$session\"}[$__range]))",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "format": "table",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Gain %"
            },
            "properties": [
              {
                "id": "unit",
                "value": "percent"
              },
              {
                "id": "decimals",
                "value": 1
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Throughput"
            },
            "properties": [
              {
                "id": "decimals",
                "value": 1
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Accuracy"
            },
            "properties": [
              {
                "id": "decimals",
                "value": 4
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Outcome"
            },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              },
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
